# Supabase > Project Settings > Database > Connection string 에서 복사한다.
# 실제 값은 .env.local 에 넣는다 (git 추적 안 됨).

# 앱 질의용. Transaction pooler (:6543).
# postgres.js 는 이 모드에서 prepare:false 로 붙는다 (lib/db.ts).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# 마이그레이션용. Session pooler (:5432). DDL 은 트랜잭션 풀러로 돌리지 않는다.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
